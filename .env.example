# Backend API. Set to enable the server mode; the value is embedded at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional server-side override for the Next.js proxy. Falls back to NEXT_PUBLIC_API_URL.
# API_URL=http://backend:8000/api/v1

# Optional map tiles. Defaults to OpenStreetMap if empty.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Cache previously viewed tiles only for providers that allow offline use.
NEXT_PUBLIC_MAP_OFFLINE_CACHE=false
