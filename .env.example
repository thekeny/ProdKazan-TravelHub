# SDK calls /api/v1 directly on the current origin. Production routes /api to the backend.
# OpenAPI generation only (not used by the browser):
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Optional map tiles. Defaults to OpenStreetMap if empty.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Cache previously viewed tiles only for providers that allow offline use.
NEXT_PUBLIC_MAP_OFFLINE_CACHE=false
